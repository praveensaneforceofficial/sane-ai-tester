				{ "name": "Update AI Status", "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"status\": \"testing_started\"\n}" }, "url": "{{baseUrl}}/api/tickets/:ticketId/ai-status", "variable": [{"key": "ticketId", "value": "TIC-001"}] } },
