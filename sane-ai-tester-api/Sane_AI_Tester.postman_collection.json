				{ "name": "Get By Category", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/category/:category", "variable": [{"key": "category", "value": "zohosprint"}] } },
				{ "name": "Get By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/:projectJobjId", "variable": [{"key": "projectJobjId", "value": "Z-PROJ-888"}] } },
				{ 
					"name": "Update Project", 
					"request": { 
						"method": "PUT", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"active_flag\": false,\n    \"description\": \"Project archived after completion\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/projects/:projectJobjId", 
						"variable": [{"key": "projectJobjId", "value": "Z-PROJ-888"}] 
					} 
				},
				{ "name": "Delete Project", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/projects/:projectJobjId", "variable": [{"key": "projectJobjId", "value": "Z-PROJ-888"}] } }
			]
		},
		{
			"name": "4. Ticket Management",
			"item": [
				{ "name": "Get All Tickets", "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets" } },
