						"method": "POST", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"project_jobj_id\": \"Z-PROJ-888\",\n    \"project_name\": \"Internal ERP System\",\n    \"category\": \"custom\",\n    \"test_type\": \"Security\",\n    \"description\": \"Comprehensive security audit of the ERP\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/projects" 
					} 
				},
				{ "name": "Get Active Projects", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects/active" } },
