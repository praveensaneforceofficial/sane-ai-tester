							"mode": "raw", 
							"raw": "{\n    \"report_id\": \"REP-MASTER-01\",\n    \"task_id\": \"task-ui-001\",\n    \"worker_id\": \"sane-tester-001\",\n    \"project_name\": \"Internal ERP\",\n    \"total_tests\": 100,\n    \"passed_tests\": 95,\n    \"failed_tests\": 5,\n    \"success_rate\": 95.0,\n    \"summary\": \"Overall good, but 5 UI regressions found.\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/reports" 
