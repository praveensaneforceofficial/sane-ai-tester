					"name": "Create Ticket", 
					"request": { 
						"method": "POST", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"ticket_id\": \"Z-TIC-55\",\n    \"project_jobj_id\": \"Z-PROJ-888\",\n    \"title\": \"Broken CSS on Login Page\",\n    \"priority\": \"Medium\",\n    \"severity\": \"Minor\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/tickets" 
					} 
				},
				{ "name": "Get AI Testing Tickets", "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets/ai-testing" } },
				{ "name": "Get By Project", "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets/project/:projectJobjId", "variable": [{"key": "projectJobjId", "value": "Z-PROJ-888"}] } },
				{ "name": "Get By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets/:ticketId", "variable": [{"key": "ticketId", "value": "Z-TIC-55"}] } },
				{ 
					"name": "Update Ticket", 
					"request": { 
						"method": "PUT", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"status\": \"Closed\",\n    \"assigned_to\": \"AI-Worker-001\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/tickets/:ticketId", 
						"variable": [{"key": "ticketId", "value": "Z-TIC-55"}] 
					} 
				},
				{ 
					"name": "Update AI Status", 
					"request": { 
						"method": "PUT", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"status\": \"failed_and_retrying\",\n    \"task_id\": \"task-ui-001\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/tickets/:ticketId/ai-status", 
						"variable": [{"key": "ticketId", "value": "Z-TIC-55"}] 
					} 
				},
				{ "name": "Get Comments", "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets/:ticketId/comments", "variable": [{"key": "ticketId", "value": "Z-TIC-55"}] } },
				{ 
					"name": "Add Comment", 
					"request": { 
						"method": "POST", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"commenter_name\": \"System-Watcher\",\n    \"comment_text\": \"AI has detected an anomaly in the layout.\",\n    \"is_ai_generated\": true\n}" 
						}, 
						"url": "{{baseUrl}}/api/tickets/:ticketId/comments", 
						"variable": [{"key": "ticketId", "value": "Z-TIC-55"}] 
					} 
				}
			]
		},
		{
			"name": "5. Test Reports",
			"item": [
