{
	"info": {
		"_postman_id": "sane-ai-tester-exhaustive-collection",
		"name": "Sane AI Tester API (Complete)",
		"description": "Exhaustive collection for testing every single API endpoint of Sane AI Tester Central API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Worker Management",
			"item": [
				{ "name": "Get All Workers", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers" } },
				{ "name": "Get Online Workers", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers/online" } },
				{ "name": "Get Worker By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Register Worker", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"machineId\": \"mac-001\",\n    \"nickname\": \"Alpha-Worker\",\n    \"ip\": \"127.0.0.1\",\n    \"os\": \"Windows 11\"\n}" }, "url": "{{baseUrl}}/api/workers/register" } },
				{ "name": "Update Status", "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"action\": \"active\"\n}" }, "url": "{{baseUrl}}/api/workers/:workerId/status", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Update Details", "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"nickname\": \"Updated-Worker\"\n}" }, "url": "{{baseUrl}}/api/workers/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Delete Worker", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/workers/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Get Heartbeats", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers/:workerId/heartbeat", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } }
			]
		},
		{
			"name": "2. Task Management",
