							"raw": "{\n    \"error_id\": \"ERR-555\",\n    \"task_id\": \"task-ui-001\",\n    \"error_type\": \"ReferenceError\",\n    \"error_message\": \"variable X is not defined\",\n    \"severity\": \"High\",\n    \"ai_analysis\": \"Likely a missing export in the source code.\"\n}" 
