				{ "name": "Get Task By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/:taskId", "variable": [{"key": "taskId", "value": "task-101"}] } },
				{ "name": "Create Task", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"task_id\": \"task-101\",\n    \"prompt\": \"Test homepage\",\n    \"url\": \"https://example.com\",\n    \"priority\": \"high\"\n}" }, "url": "{{baseUrl}}/api/tasks" } },
				{ "name": "Update Status", "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"status\": \"completed\"\n}" }, "url": "{{baseUrl}}/api/tasks/:taskId/status", "variable": [{"key": "taskId", "value": "task-101"}] } },
				{ "name": "Assign Task", "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"workerId\": \"sane-tester-001\"\n}" }, "url": "{{baseUrl}}/api/tasks/:taskId/assign", "variable": [{"key": "taskId", "value": "task-101"}] } },
				{ "name": "Retry Task", "request": { "method": "POST", "url": "{{baseUrl}}/api/tasks/:taskId/retry", "variable": [{"key": "taskId", "value": "task-101"}] } },
				{ "name": "Cancel Task", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tasks/:taskId", "variable": [{"key": "taskId", "value": "task-101"}] } },
				{ "name": "Get By Worker", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/worker/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Get By Status", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/status/:status", "variable": [{"key": "status", "value": "pending"}] } },
				{ "name": "Add Action", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\n    \"step_number\": 1,\n    \"action_type\": \"click\",\n    \"selector\": \"#btn\",\n    \"success\": true\n}" }, "url": "{{baseUrl}}/api/tasks/:taskId/actions", "variable": [{"key": "taskId", "value": "task-101"}] } },
				{ "name": "Get Actions", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/:taskId/actions", "variable": [{"key": "taskId", "value": "task-101"}] } }
			]
		},
