				{ "name": "Get By Severity", "request": { "method": "GET", "url": "{{baseUrl}}/api/errors/severity/:severity", "variable": [{"key": "severity", "value": "High"}] } },
				{ "name": "Get By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/errors/:errorId", "variable": [{"key": "errorId", "value": "ERR-555"}] } },
				{ "name": "Resolve Error", "request": { "method": "PUT", "url": "{{baseUrl}}/api/errors/:errorId/resolve", "variable": [{"key": "errorId", "value": "ERR-555"}] } }
			]
		},
