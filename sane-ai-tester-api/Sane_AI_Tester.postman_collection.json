				{ "name": "Get By Worker", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/worker/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Get By Project", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/project/:projectName", "variable": [{"key": "projectName", "value": "Internal ERP"}] } },
				{ "name": "Get By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/:reportId", "variable": [{"key": "reportId", "value": "REP-MASTER-01"}] } },
				{ "name": "Delete Report", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/reports/:reportId", "variable": [{"key": "reportId", "value": "REP-MASTER-01"}] } },
				{ "name": "Download Report", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/:reportId/download", "variable": [{"key": "reportId", "value": "REP-MASTER-01"}] } }
			]
		},
		{
			"name": "6. Error Logs",
			"item": [
