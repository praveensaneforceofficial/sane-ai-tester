{
	"info": {
		"_postman_id": "sane-ai-tester-descriptive-collection",
		"name": "Sane AI Tester API (with Samples)",
		"description": "Exhaustive collection with detailed sample parameters and request bodies for all Sane AI Tester APIs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Worker Management",
			"item": [
				{ "name": "Get All Workers", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers" } },
				{ "name": "Get Online Workers", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers/online" } },
				{ "name": "Get Worker By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ 
					"name": "Register Worker", 
					"request": { 
						"method": "POST", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"machineId\": \"mac-12345\",\n    \"nickname\": \"Central-Worker-Node\",\n    \"ip\": \"192.168.1.15\",\n    \"os\": \"Windows 11 Pro\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/workers/register" 
					} 
				},
				{ 
					"name": "Update Status", 
					"request": { 
						"method": "PUT", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"action\": \"active\" \n    // Options: 'active' (mark online), 'offline' (mark offline), 'remove' (delete)\n}" 
						}, 
						"url": "{{baseUrl}}/api/workers/:workerId/status", 
						"variable": [{"key": "workerId", "value": "sane-tester-001"}] 
					} 
				},
				{ 
					"name": "Update Details", 
					"request": { 
						"method": "PUT", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"nickname\": \"Master-Worker-Refined\",\n    \"workerType\": \"cloud_instance\",\n    \"version\": \"v2.0.1\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/workers/:workerId", 
						"variable": [{"key": "workerId", "value": "sane-tester-001"}] 
					} 
				},
				{ "name": "Delete Worker", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/workers/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Get Heartbeats", "request": { "method": "GET", "url": "{{baseUrl}}/api/workers/:workerId/heartbeat", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } }
			]
		},
		{
			"name": "2. Task Management",
			"item": [
				{ "name": "Get All Tasks", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks" } },
				{ "name": "Get Task By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/:taskId", "variable": [{"key": "taskId", "value": "task-101"}] } },
				{ 
					"name": "Create Task", 
					"request": { 
						"method": "POST", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"task_id\": \"task-ui-001\",\n    \"worker_id\": \"sane-tester-001\",\n    \"prompt\": \"Test the checkout flow with invalid credit card\",\n    \"url\": \"https://example-shop.com/checkout\",\n    \"priority\": \"high\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/tasks" 
					} 
				},
				{ 
					"name": "Update Status", 
					"request": { 
						"method": "PUT", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"status\": \"failed\",\n    \"error\": \"Element #checkout-btn not found after 30s timeout\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/tasks/:taskId/status", 
						"variable": [{"key": "taskId", "value": "task-ui-001"}] 
					} 
				},
				{ 
					"name": "Assign Task", 
					"request": { 
						"method": "PUT", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"workerId\": \"sane-tester-002\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/tasks/:taskId/assign", 
						"variable": [{"key": "taskId", "value": "task-ui-001"}] 
					} 
				},
				{ "name": "Retry Task", "request": { "method": "POST", "url": "{{baseUrl}}/api/tasks/:taskId/retry", "variable": [{"key": "taskId", "value": "task-ui-001"}] } },
				{ "name": "Cancel Task", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tasks/:taskId", "variable": [{"key": "taskId", "value": "task-ui-001"}] } },
				{ "name": "Get By Worker", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/worker/:workerId", "variable": [{"key": "workerId", "value": "sane-tester-001"}] } },
				{ "name": "Get By Status", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/status/:status", "variable": [{"key": "status", "value": "pending"}] } },
				{ 
					"name": "Add Action (Step)", 
					"request": { 
						"method": "POST", 
						"header": [{"key": "Content-Type", "value": "application/json"}], 
						"body": { 
							"mode": "raw", 
							"raw": "{\n    \"step_number\": 1,\n    \"action_type\": \"type\",\n    \"selector\": \"input[name='cc-number']\",\n    \"value\": \"4111 1111 1111 1111\",\n    \"success\": true,\n    \"screenshot_path\": \"/storage/tasks/task-ui-001/step1.png\"\n}" 
						}, 
						"url": "{{baseUrl}}/api/tasks/:taskId/actions", 
						"variable": [{"key": "taskId", "value": "task-ui-001"}] 
					} 
				},
				{ "name": "Get Actions", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks/:taskId/actions", "variable": [{"key": "taskId", "value": "task-ui-001"}] } }
			]
		},
		{
			"name": "3. Project Management",
			"item": [
