# API Bridge Configuration
# API_URL=http://localhost:3000
# API_WS_URL=ws://localhost:3000
API_URL=http://uatai.saneforce.com
API_WS_URL=ws://uatai.saneforce.com


# Worker Configuration
WORKER_NAME=
WORKER_TYPE=web_local
RECORD_VIDEO=true
SAVE_SCREENSHOTS=true
MAX_CONCURRENT_TASKS=1

# Recording Paths
RECORDING_PATH=./recordings
SCREENSHOT_PATH=./recordings/screenshots
VIDEO_PATH=./recordings/videos
LOG_PATH=./recordings/logs

# Browser Settings
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=100
DEFAULT_TIMEOUT=30000

# AI Configuration (Local)
AI_MODE=local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Or use OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Logging
LOG_LEVEL=info